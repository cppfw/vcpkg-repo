{
  "name": "ruisapp",
  "version": "0.2.149",
  "description": "ruis platform abstraction layer",
  "homepage": "https://github.com/cppfw/ruisapp",
  "license": "MIT",
  "dependencies": [
    "myci",
    "nitki",
    "ruis",
    {
      "name": "ruis-render-opengl",
      "platform": "!ios"
    },
    {
      "name": "ruis-render-opengles",
      "platform": "!osx"
    },
    "ruis-render-vulkan",
    "sdl2",
    "setka",
    "utki",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "vulkan-loader",
      "features": [
        "wayland",
        "xlib"
      ],
      "platform": "linux"
    }
  ]
}
